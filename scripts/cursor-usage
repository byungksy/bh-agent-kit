#!/bin/bash
set -euo pipefail

DB_PATH="$HOME/Library/Application Support/Cursor/User/globalStorage/state.vscdb"

TOKEN=$(sqlite3 "$DB_PATH" \
  "SELECT value FROM ItemTable WHERE key = 'cursorAuth/accessToken';" 2>/dev/null)
if [[ -z "$TOKEN" ]]; then
  echo "❌ Cursor 인증 토큰을 찾을 수 없습니다."
  exit 1
fi

USER_ID=$(echo "$TOKEN" | cut -d. -f2 | base64 -d 2>/dev/null \
  | python3 -c "import sys,json; print(json.load(sys.stdin).get('sub',''))")
COOKIE="WorkosCursorSessionToken=${USER_ID}::${TOKEN}"

USAGE_JSON=$(curl -sL -H "Authorization: Bearer $TOKEN" \
  "https://api2.cursor.sh/auth/usage" 2>/dev/null)
SUMMARY_JSON=$(curl -sL -b "$COOKIE" \
  "https://www.cursor.com/api/usage-summary" 2>/dev/null)

export USAGE_JSON SUMMARY_JSON

python3 << 'PYEOF'
import json, os, subprocess
from datetime import datetime, timezone

usage = json.loads(os.environ.get("USAGE_JSON", "{}"))
summary = json.loads(os.environ.get("SUMMARY_JSON", "{}"))

has_summary = "error" not in summary and "billingCycleEnd" in summary

membership = summary.get("membershipType", "unknown") if has_summary else "unknown"
limit_type = summary.get("limitType", "")
plan_label = f"{membership}" + (f" ({limit_type})" if limit_type else "")

if has_summary:
    end_str = summary.get("billingCycleEnd", "")
    end_dt = datetime.fromisoformat(end_str.replace("Z", "+00:00"))
    days_left = (end_dt - datetime.now(timezone.utc)).days
    reset_display = end_dt.strftime("%Y-%m-%d")
else:
    start_str = usage.get("startOfMonth", "")
    if start_str:
        from datetime import timedelta
        start_dt = datetime.fromisoformat(start_str.replace("Z", "+00:00"))
        end_dt = start_dt + timedelta(days=30)
        days_left = (end_dt - datetime.now(timezone.utc)).days
        reset_display = end_dt.strftime("%Y-%m-%d")
    else:
        days_left, reset_display = "?", "알 수 없음"

sep = "━" * 36
print(f"\n{sep}")
print("  ⚡ Cursor AI 사용량 리포트")
print(f"{sep}\n")
print(f"  📋 플랜: {plan_label}")
print(f"  📅 리셋: {reset_display} ({days_left}일 남음)")

if has_summary:
    auto_msg = summary.get("autoModelSelectedDisplayMessage", "")
    if auto_msg:
        print(f"  💬 {auto_msg}")
print()

notif_parts = []

for key in sorted(k for k in usage if k != "startOfMonth"):
    m = usage[key]
    used = m.get("numRequests", 0) or 0
    total = m.get("maxRequestUsage", 0) or 0
    if total > 0:
        remaining = total - used
        pct = used / total * 100
        filled = int(20 * min(pct, 100) / 100)
        bar = "█" * filled + "░" * (20 - filled)
        icon = "🔴" if pct >= 90 else ("🟡" if pct >= 70 else "🟢")
        print(f"  {icon} Premium Requests")
        print(f"     [{bar}] {pct:.1f}%")
        print(f"     {used}/{total} 사용 · {remaining}건 남음")
        print()
        notif_parts.append(f"Premium: {remaining}/{total}")

if has_summary:
    individual = summary.get("individualUsage", {})
    on_demand = individual.get("onDemand", {})
    if on_demand.get("enabled"):
        od_used = on_demand.get("used", 0)
        od_limit = on_demand.get("limit", 0)
        od_remaining = on_demand.get("remaining", 0)
        od_used_d = od_used / 100
        od_limit_d = od_limit / 100
        od_remaining_d = od_remaining / 100
        od_pct = (od_used / od_limit * 100) if od_limit > 0 else 0
        filled = int(20 * min(od_pct, 100) / 100)
        bar = "█" * filled + "░" * (20 - filled)
        if od_pct >= 90: icon = "🔴"
        elif od_pct >= 70: icon = "🟡"
        elif od_used > 0: icon = "💰"
        else: icon = "⚪"
        print(f"  {icon} On-Demand (개인)")
        print(f"     [{bar}] {od_pct:.1f}%")
        print(f"     ${od_used_d:.2f} / ${od_limit_d:.2f} 사용 · ${od_remaining_d:.2f} 남음")
        print()
        notif_parts.append(f"On-Demand: ${od_used_d:.2f}/${od_limit_d:.2f}")

    team_od = summary.get("teamUsage", {}).get("onDemand", {})
    if team_od.get("enabled"):
        tod_used = team_od.get("used", 0)
        tod_limit = team_od.get("limit", 0)
        tod_used_d = tod_used / 100
        tod_limit_d = tod_limit / 100
        tod_pct = (tod_used / tod_limit * 100) if tod_limit > 0 else 0
        filled = int(20 * min(tod_pct, 100) / 100)
        bar = "█" * filled + "░" * (20 - filled)
        icon = "🔴" if tod_pct >= 90 else ("🟡" if tod_pct >= 70 else "🟢")
        print(f"  {icon} On-Demand (팀)")
        print(f"     [{bar}] {tod_pct:.1f}%")
        print(f"     ${tod_used_d:.2f} / ${tod_limit_d:.2f} 사용")
        print()

print(sep)

notif_body = " | ".join(notif_parts) + f" · 리셋 {days_left}일 후"
subprocess.run([
    "osascript", "-e",
    f'display notification "{notif_body}" with title "⚡ Cursor Usage"'
], capture_output=True)

# Hammerspoon 토스트 알림 추가
subprocess.run([
    "open", "-g",
    f"hammerspoon://alert?msg=⚡ Cursor Usage - {notif_body}"
], capture_output=True)
PYEOF
