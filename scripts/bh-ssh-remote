#!/usr/bin/env bash
# bh-ssh-remote — SSH 서버 관리 및 접속 도구
# 저장 포맷: local_user@remote_user@jump_host@target_host (target 없으면 직접 접속)

STORE="${BH_SSH_REMOTE_STORE:-$HOME/.bh-ssh-remote/servers}"
mkdir -p "$(dirname "$STORE")"
touch "$STORE"

usage() {
  cat <<EOF
bh-ssh-remote — SSH 접속 관리

사용법:
  bh-ssh-remote               # 서버 목록에서 번호 선택 후 SSH 접속
  bh-ssh-remote add <entry>   # 서버 추가
  bh-ssh-remote ls            # 서버 목록
  bh-ssh-remote rm <번호>     # 서버 삭제
  bh-ssh-remote help          # 이 도움말

entry 포맷:
  remote_user@host                          # 직접 접속
  remote_user@host [레이블]                  # 레이블 지정 직접 접속
  local_user@remote_user@jump@target        # ProxyJump 경유
  local_user@remote_user@jump@target [레이블]

저장 파일: $STORE
EOF
}

die() { echo "오류: $*" >&2; exit 1; }

entry_to_cmd() {
  echo "ssh $1"
}

load_entries() {
  ENTRIES=()
  LABELS=()
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    local entry label
    entry="$(echo "$line" | cut -f1)"
    label="$(echo "$line" | cut -sf2)"
    ENTRIES+=("$entry")
    LABELS+=("$label")
  done < "$STORE"
}

cmd_ls() {
  load_entries
  if [[ ${#ENTRIES[@]} -eq 0 ]]; then
    echo "등록된 서버가 없습니다."
    echo "  bh-ssh-remote add <entry>  로 추가하세요."
    return 0
  fi

  echo "── 등록된 서버 목록 ─────────────────────────────"
  local i
  for i in "${!ENTRIES[@]}"; do
    local label="${LABELS[$i]}"
    printf "%3d) %s%s\n" "$((i+1))" "${ENTRIES[$i]}" "${label:+  # ${label}}"
    printf "     → %s\n" "$(entry_to_cmd "${ENTRIES[$i]}")"
  done
}

cmd_add() {
  local entry="${1:-}"
  local label="${2:-}"
  [[ -z "$entry" ]] && die "entry를 입력하세요. 예: bh-ssh-remote add devuser@172.28.1.1"

  if grep -qF "$entry" "$STORE" 2>/dev/null; then
    echo "이미 등록된 항목입니다: $entry"
    return 0
  fi

  if [[ -n "$label" ]]; then
    printf '%s\t%s\n' "$entry" "$label" >> "$STORE"
  else
    echo "$entry" >> "$STORE"
  fi

  echo "등록 완료: $entry${label:+  (${label})}"
  echo "  SSH 명령: $(entry_to_cmd "$entry")"
}

cmd_rm() {
  load_entries
  [[ ${#ENTRIES[@]} -eq 0 ]] && die "등록된 서버가 없습니다."

  local lines=()
  local i
  for i in "${!ENTRIES[@]}"; do
    local label="${LABELS[$i]}"
    lines+=("${ENTRIES[$i]}${label:+	# ${label}}")
  done

  local selected
  selected="$(printf '%s\n' "${lines[@]}" | fzf --prompt="삭제할 서버 > " \
    --height=40% --layout=reverse --border --no-multi | awk '{print $1}')"

  [[ -z "$selected" ]] && { echo "취소됨"; return 0; }

  local tmpfile
  tmpfile="$(mktemp)"
  grep -vF "$selected" "$STORE" > "$tmpfile" || true
  mv "$tmpfile" "$STORE"
  echo "삭제 완료: $selected"
}

cmd_connect() {
  load_entries
  [[ ${#ENTRIES[@]} -eq 0 ]] && die "등록된 서버가 없습니다. 먼저 bh-ssh-remote add 로 추가하세요."

  local lines=()
  local i
  for i in "${!ENTRIES[@]}"; do
    local label="${LABELS[$i]}"
    lines+=("${ENTRIES[$i]}${label:+	# ${label}}")
  done

  local selected
  selected="$(printf '%s\n' "${lines[@]}" | fzf --prompt="접속할 서버 > " \
    --height=40% --layout=reverse --border --no-multi | awk '{print $1}')"

  [[ -z "$selected" ]] && { echo "취소됨"; return 0; }

  local cmd
  cmd="$(entry_to_cmd "$selected")"
  echo "접속: $cmd"
  eval "$cmd"
}

case "${1:-}" in
  add)          shift; cmd_add "$@" ;;
  ls|list)      cmd_ls ;;
  rm|del|delete) shift; cmd_rm "$@" ;;
  help|-h|--help) usage ;;
  "")           cmd_connect ;;
  *)            die "알 수 없는 명령: $1  (bh-ssh-remote help 참고)" ;;
esac
