#!/usr/bin/env bash

# bh-view-md: A beautiful local markdown viewer.
# Opens a markdown file in the browser with premium styling, code highlighting, and TOC.

if [ -z "$1" ]; then
    echo "Usage: bh-view-md <markdown-file-path>"
    exit 1
fi

MD_FILE="$1"

if [ ! -f "$MD_FILE" ]; then
    echo "Error: File '$MD_FILE' does not exist."
    exit 1
fi

# Get absolute path and metadata
ABS_MD_FILE=$(python3 -c "import os; print(os.path.abspath('$MD_FILE'))")
FILE_NAME=$(basename "$ABS_MD_FILE")
FILE_DIR=$(dirname "$ABS_MD_FILE")
TEMP_HTML="/tmp/bh-view-md-$(date +%s).html"

# HTML Template with Premium Design (Glassmorphism, TOC, Dark/Light Mode, Custom Fonts)
cat << 'EOF' > "$TEMP_HTML.template"
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Viewer: {{FILE_NAME}}</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Outfit:wght@300;400;500;600;700&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
    
    <!-- Markdown & Code Highlight Library Styles -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.5.0/github-markdown.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" id="prism-theme" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <style>
        :root {
            --bg-color: #0d1117;
            --container-bg: #161b22;
            --text-color: #c9d1d9;
            --accent-color: #58a6ff;
            --border-color: #30363d;
            --sidebar-bg: rgba(22, 27, 34, 0.8);
            --header-bg: rgba(13, 17, 23, 0.7);
            --shadow-color: rgba(0, 0, 0, 0.5);
            --toc-active: #58a6ff;
        }

        [data-theme="light"] {
            --bg-color: #f6f8fa;
            --container-bg: #ffffff;
            --text-color: #24292f;
            --accent-color: #0969da;
            --border-color: #d0d7de;
            --sidebar-bg: rgba(255, 255, 255, 0.8);
            --header-bg: rgba(246, 248, 250, 0.7);
            --shadow-color: rgba(0, 0, 0, 0.08);
            --toc-active: #0969da;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Outfit', 'Noto Sans KR', -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            transition: background-color 0.3s, color 0.3s;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Premium Header */
        header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 60px;
            background-color: var(--header-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            z-index: 1000;
            box-shadow: 0 4px 30px var(--shadow-color);
        }

        .header-title-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-title-container i {
            color: var(--accent-color);
            font-size: 20px;
        }

        .header-title {
            font-size: 16px;
            font-weight: 600;
            letter-spacing: -0.3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 400px;
        }

        .header-path {
            font-size: 12px;
            color: #8b949e;
            margin-left: 8px;
            font-family: 'Fira Code', monospace;
        }

        .controls {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            color: var(--text-color);
            padding: 8px 12px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-family: 'Outfit', sans-serif;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        [data-theme="light"] .btn {
            background: rgba(0, 0, 0, 0.03);
        }

        .btn:hover {
            background: var(--accent-color);
            color: #ffffff;
            border-color: var(--accent-color);
            transform: translateY(-1px);
        }

        /* App Layout */
        .app-container {
            display: flex;
            margin-top: 60px;
            min-height: calc(100vh - 60px);
            position: relative;
        }

        /* Sidebar / TOC */
        .sidebar {
            width: 280px;
            background-color: var(--sidebar-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-right: 1px solid var(--border-color);
            padding: 24px;
            position: fixed;
            top: 60px;
            bottom: 0;
            left: 0;
            overflow-y: auto;
            z-index: 900;
        }

        .sidebar-title {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #8b949e;
            margin-bottom: 16px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .toc-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .toc-item {
            margin-bottom: 8px;
        }

        .toc-link {
            color: var(--text-color);
            text-decoration: none;
            font-size: 14px;
            display: block;
            padding: 6px 12px;
            border-radius: 6px;
            transition: all 0.2s;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            opacity: 0.75;
        }

        .toc-link:hover {
            opacity: 1;
            background: rgba(255, 255, 255, 0.05);
            color: var(--accent-color);
            padding-left: 16px;
        }

        [data-theme="light"] .toc-link:hover {
            background: rgba(0, 0, 0, 0.04);
        }

        .toc-link.active {
            opacity: 1;
            font-weight: 600;
            color: var(--toc-active);
            background: rgba(88, 166, 255, 0.1);
            border-left: 3px solid var(--toc-active);
            border-radius: 0 6px 6px 0;
            padding-left: 12px;
        }

        /* Main Content */
        main {
            flex: 1;
            margin-left: 280px;
            padding: 40px;
            display: flex;
            justify-content: center;
        }

        .content-card {
            width: 100%;
            max-width: 860px;
            background-color: var(--container-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 48px;
            box-shadow: 0 10px 40px var(--shadow-color);
            box-sizing: border-box;
        }

        /* Markdown Overrides */
        .markdown-body {
            background-color: transparent !important;
            color: var(--text-color) !important;
            font-family: inherit !important;
        }

        .markdown-body pre {
            background-color: #161b22 !important;
            border: 1px solid var(--border-color) !important;
            border-radius: 10px !important;
        }

        [data-theme="light"] .markdown-body pre {
            background-color: #f6f8fa !important;
        }

        .markdown-body code {
            font-family: 'Fira Code', monospace !important;
        }

        .markdown-body img {
            border-radius: 10px;
            box-shadow: 0 4px 20px var(--shadow-color);
        }

        /* Floating Scroll to Top button */
        .scroll-top {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: var(--accent-color);
            color: white;
            border: none;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 1000;
        }

        .scroll-top.visible {
            opacity: 1;
            visibility: visible;
        }

        .scroll-top:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
        }

        /* Scrollbar styling */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-color);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--accent-color);
        }

        @media (max-width: 1024px) {
            .sidebar {
                display: none;
            }
            main {
                margin-left: 0;
                padding: 20px;
            }
            .content-card {
                padding: 24px;
                border-radius: 12px;
            }
        }
    </style>
</head>
<body data-theme="dark">

    <header>
        <div class="header-title-container">
            <i class="fa-solid fa-file-lines"></i>
            <span class="header-title" id="doc-title">{{FILE_NAME}}</span>
            <span class="header-path" id="doc-path">{{FILE_DIR}}</span>
        </div>
        <div class="controls">
            <button class="btn" onclick="toggleTheme()" title="테마 전환">
                <i class="fa-solid fa-circle-half-stroke"></i>
                <span id="theme-btn-text">Light Mode</span>
            </button>
            <button class="btn" onclick="window.print()" title="PDF 인쇄">
                <i class="fa-solid fa-print"></i>
                <span>Print PDF</span>
            </button>
        </div>
    </header>

    <div class="app-container">
        <aside class="sidebar">
            <div class="sidebar-title">
                <i class="fa-solid fa-list-ul"></i>
                <span>Table of Contents</span>
            </div>
            <ul class="toc-list" id="toc-list">
                <!-- TOC items will be injected here -->
            </ul>
        </aside>

        <main>
            <article class="content-card">
                <div class="markdown-body" id="content">
                    <!-- Markdown output will be here -->
                </div>
            </article>
        </main>
    </div>

    <button class="scroll-top" id="scroll-btn" onclick="scrollToTop()">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <!-- Markdown Parser & Highlighter Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>

    <script>
        // Insert Markdown content here via script
        const rawMarkdown = {{MARKDOWN_CONTENT}};
        
        // Configure marked options
        marked.setOptions({
            gfm: true,
            breaks: true,
            headerIds: true,
            mangle: false
        });

        // Render Markdown
        document.getElementById('content').innerHTML = marked.parse(rawMarkdown);

        // Highlight code blocks
        Prism.highlightAll();

        // Build Table of Contents
        const tocList = document.getElementById('toc-list');
        const headers = document.querySelectorAll('#content h1, #content h2, #content h3');
        
        headers.forEach((header, index) => {
            const level = parseInt(header.tagName.replace('H', ''), 10);
            const text = header.textContent;
            
            // Create anchor ID if it doesn't exist
            const anchorId = `toc-anchor-${index}`;
            header.id = anchorId;

            const li = document.createElement('li');
            li.className = 'toc-item';
            li.style.paddingLeft = `${(level - 1) * 12}px`;

            const a = document.createElement('a');
            a.href = `#${anchorId}`;
            a.className = 'toc-link';
            a.textContent = text;
            a.title = text;

            li.appendChild(a);
            tocList.appendChild(li);
        });

        // Theme Toggle (Dark / Light)
        function toggleTheme() {
            const body = document.body;
            const currentTheme = body.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            body.setAttribute('data-theme', newTheme);
            
            const btnText = document.getElementById('theme-btn-text');
            btnText.textContent = newTheme === 'dark' ? 'Light Mode' : 'Dark Mode';

            // Swap Prism theme
            const prismLink = document.getElementById('prism-theme');
            if (newTheme === 'light') {
                prismLink.href = 'https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-coy.min.css';
            } else {
                prismLink.href = 'https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css';
            }
        }

        // Active TOC indicator on scroll
        window.addEventListener('scroll', () => {
            let currentActive = null;
            headers.forEach(header => {
                const rect = header.getBoundingClientRect();
                if (rect.top <= 100) {
                    currentActive = header;
                }
            });

            document.querySelectorAll('.toc-link').forEach(link => {
                link.classList.remove('active');
                if (currentActive && link.getAttribute('href') === `#${currentActive.id}`) {
                    link.classList.add('active');
                }
            });

            // Show scroll to top button
            const scrollBtn = document.getElementById('scroll-btn');
            if (window.scrollY > 300) {
                scrollBtn.classList.add('visible');
            } else {
                scrollBtn.classList.remove('visible');
            }
        });

        function scrollToTop() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        }
    </script>
</body>
</html>
EOF

# Escape and Inject values safely via Python (to prevent bash escaping bugs)
python3 -c "
import json

with open('$TEMP_HTML.template', 'r', encoding='utf-8') as f:
    template = f.read()

with open('$ABS_MD_FILE', 'r', encoding='utf-8') as f:
    md_content = f.read()

# Replace variables
output = template.replace('{{FILE_NAME}}', json.dumps('$FILE_NAME')[1:-1])
output = output.replace('{{FILE_DIR}}', json.dumps('$FILE_DIR')[1:-1])
output = output.replace('{{MARKDOWN_CONTENT}}', json.dumps(md_content))

with open('$TEMP_HTML', 'w', encoding='utf-8') as f:
    f.write(output)
"

# Clean up template
rm "$TEMP_HTML.template"

# Open in default web browser on macOS
open "$TEMP_HTML"

# Automatically delete the temp file after 10 seconds to keep clean
(sleep 10 && rm "$TEMP_HTML") &
