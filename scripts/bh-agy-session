#!/usr/bin/env bash
# Antigravity CLI 세션 뷰어 및 복구기 (bh-agy-session)
# - fzf로 Antigravity 대화 세션 선택 → agy --conversation <ID> 로 즉시 세션 복구
# - ←/→ 화살표로 날짜 전환 (최대 14일 전)
# - Tab으로 실시간 이전 대화 내용 미리보기

set -euo pipefail

AGY_BRAIN="/Users/a1101969/.gemini/antigravity-cli/brain"
AGY_BIN="/Users/a1101969/.local/bin/agy"
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
DAYS_KR=("일" "월" "화" "수" "목" "금" "토")
MAX_OFFSET=13

get_date_with_offset() {
  date -v-${1}d +%Y-%m-%d
}

get_weekday_kr() {
  local dow
  dow=$(date -j -f "%Y-%m-%d" "$1" "+%w" 2>/dev/null || date -d "$1" "+%w" 2>/dev/null)
  echo "${DAYS_KR[$dow]}"
}

# ═══════════════════════════════════════════════════════════════
# 내부 서브커맨드: --collect DATE FROM_HOUR
#   fzf reload에서 호출. 세션 목록을 stdout으로 출력
# ═══════════════════════════════════════════════════════════════
if [[ "${1:-}" == "--collect" ]]; then
  TARGET_DATE="${2:-$(date +%Y-%m-%d)}"
  FROM_HOUR="${3:-08:00}"
  SINCE="${TARGET_DATE} ${FROM_HOUR}:00"

  find "$AGY_BRAIN" -name "transcript.jsonl" -newermt "$SINCE" -print0 2>/dev/null \
    | while IFS= read -r -d '' f; do
      mod=$(stat -f "%Sm" -t "%Y-%m-%d %H:%M" "$f" 2>/dev/null || stat --format="%y" "$f" 2>/dev/null | cut -c1-16)
      [[ "$mod" == "${TARGET_DATE}"* ]] && echo "$mod|$f"
    done \
    | sort \
    | while IFS='|' read -r mod filepath; do
      uuid=$(basename "$(dirname "$(dirname "$(dirname "$filepath")")")")
      
      # Python 스크립트로 워크스페이스 명칭 및 첫 질문 파싱
      parsed=$(python3 - "$filepath" <<'PYEOF'
import sys, json, re
path = sys.argv[1]
workspace = "Unknown"
first_query = "(내용 없음)"

try:
    with open(path, "r", encoding="utf-8") as f:
        content_full = ""
        for line in f:
            line = line.strip()
            if not line:
                continue
            content_full += line + "\n"
            try:
                obj = json.loads(line)
                if obj.get("type") == "USER_INPUT" and first_query == "(내용 없음)":
                    raw_content = obj.get("content", "")
                    m = re.search(r'<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>', raw_content, re.DOTALL)
                    if m:
                        first_query = m.group(1).strip().replace('\n', ' ')[:80]
                    else:
                        first_query = raw_content.strip().replace('\n', ' ')[:80]
            except Exception:
                pass
        
        # 전체 로그에서 워크스페이스 경로 추출 시도
        m_ws = re.search(r'/Users/a1101969/(WebstormProjects|Projects|Desktop)/([^/"]+)', content_full)
        if m_ws:
            workspace = m_ws.group(2)
except Exception:
    pass

print(f"{workspace}\t{first_query}")
PYEOF
)
      project_name=$(echo "$parsed" | cut -f1)
      query=$(echo "$parsed" | cut -f2)
      
      printf "%s  %-26s  %s\t%s\n" "$mod" "$project_name" "$query" "$uuid"
    done

  exit 0
fi

# ═══════════════════════════════════════════════════════════════
# 내부 서브커맨드: --nav OFFSET_FILE DIRECTION FROM_HOUR
#   날짜 offset을 prev/next로 이동하고 새 세션 목록 출력
# ═══════════════════════════════════════════════════════════════
if [[ "${1:-}" == "--nav" ]]; then
  OFFSET_FILE="$2"
  DIRECTION="$3"
  FROM_HOUR="$4"

  current=$(cat "$OFFSET_FILE")

  if [[ "$DIRECTION" == "prev" ]]; then
    new_offset=$((current + 1))
    [ $new_offset -gt $MAX_OFFSET ] && new_offset=$MAX_OFFSET
  else
    new_offset=$((current - 1))
    [ $new_offset -lt 0 ] && new_offset=0
  fi

  echo "$new_offset" > "$OFFSET_FILE"
  target=$(get_date_with_offset "$new_offset")
  "$SCRIPT_PATH" --collect "$target" "$FROM_HOUR" | tail -10 | cut -f1
  exit 0
fi

# ═══════════════════════════════════════════════════════════════
# 내부 서브커맨드: --header OFFSET_FILE FROM_HOUR
#   현재 offset 기준 헤더 문자열 반환
# ═══════════════════════════════════════════════════════════════
if [[ "${1:-}" == "--header" ]]; then
  OFFSET_FILE="$2"
  FROM_HOUR="$3"

  off=$(cat "$OFFSET_FILE")
  d=$(get_date_with_offset "$off")
  weekday=$(get_weekday_kr "$d")

  if [ "$off" -eq 0 ]; then
    label="오늘"
  elif [ "$off" -eq 1 ]; then
    label="어제"
  else
    label="${off}일 전"
  fi

  echo "📋 ${d} (${weekday}, ${label}) ${FROM_HOUR}~ — ←/→ 날짜 전환, Tab 미리보기, Enter 세션 복구(agy resume), Esc 취소"
  exit 0
fi

# ═══════════════════════════════════════════════════════════════
# 내부 서브커맨드: --detail UUID
#   fzf execute 바인딩에서 호출. 대화 내용을 stdout으로 출력
# ═══════════════════════════════════════════════════════════════
if [[ "${1:-}" == "--detail" ]]; then
  DISPLAY_LINE="$2"
  OFFSET_FILE="$3"
  FROM_HOUR_ARG="$4"

  off=$(cat "$OFFSET_FILE" 2>/dev/null || echo "0")
  target=$(get_date_with_offset "$off")

  uuid=$("$SCRIPT_PATH" --collect "$target" "$FROM_HOUR_ARG" \
    | grep -F "$DISPLAY_LINE" \
    | head -1 \
    | cut -f2)

  if [ -z "$uuid" ]; then
    echo "⚠️  세션을 찾을 수 없습니다: [$DISPLAY_LINE]"
    exit 0
  fi

  jsonl_path="${AGY_BRAIN}/${uuid}/.system_generated/logs/transcript.jsonl"

  if [ ! -f "$jsonl_path" ]; then
    echo "⚠️  파일을 찾을 수 없습니다: ${uuid}/transcript.jsonl"
    exit 0
  fi

  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  💬 Antigravity 세션 상세: ${uuid}"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""

  python3 - "$jsonl_path" <<'PYEOF'
import sys, json, re, textwrap

path = sys.argv[1]
messages = []

try:
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
                type_val = obj.get("type", "")
                content = obj.get("content", "")
                
                if type_val == "USER_INPUT" and content:
                    m = re.search(r'<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>', content, re.DOTALL)
                    if m:
                        content = m.group(1)
                    else:
                        content = re.sub(r'<[^>]+>', '', content)
                    messages.append(("user", content.strip()))
                    
                elif type_val == "PLANNER_RESPONSE" and content:
                    # 마크다운 태그 간소화
                    clean_content = re.sub(r'<[^>]+>', '', content)
                    messages.append(("assistant", clean_content.strip()))
            except Exception:
                continue
except Exception as e:
    print(f"Error reading transcript: {e}")
    sys.exit(0)

if not messages:
    print("(대화 내용 없음)")
    sys.exit(0)

COLS = 72
SEP = "─" * COLS

for role, text in messages:
    if role == "user":
        header = "\033[1;44;97m  👤 사용자 (USER_INPUT)  \033[0m"
        indent = "  "
    else:
        header = "\033[1;42;30m  🤖 AI (PLANNER_RESPONSE)  \033[0m"
        indent = "  "

    print(header)
    for para in text.split("\n"):
        if para.strip():
            wrapped = textwrap.fill(para, width=COLS - len(indent),
                                    initial_indent=indent,
                                    subsequent_indent=indent)
            print(wrapped)
        else:
            print()
    print(f"\033[2m{SEP}\033[0m")
PYEOF

  exit 0
fi

# ═══════════════════════════════════════════════════════════════
# 메인 진입점
# ═══════════════════════════════════════════════════════════════

FROM_HOUR="00:00"
TARGET_DATE=$(date +%Y-%m-%d)
LIST_ONLY=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --from) FROM_HOUR="$2"; shift 2 ;;
    --date) TARGET_DATE="$2"; shift 2 ;;
    --list) LIST_ONLY=true; shift ;;
    -h|--help)
      echo "Usage: $0 [--from HH:MM] [--date YYYY-MM-DD] [--list]"
      echo ""
      echo "Options:"
      echo "  --from HH:MM       시작 시간 (기본: 00:00)"
      echo "  --date YYYY-MM-DD  대상 날짜 (기본: 오늘)"
      echo "  --list             fzf 없이 목록만 출력"
      echo ""
      echo "fzf 모드:"
      echo "  ←/→               이전/다음 날짜 (최대 14일 전)"
      echo "  Enter              선택한 세션을 Antigravity CLI로 즉시 이어하기"
      echo "  Esc                종료"
      exit 0
      ;;
    *) echo "Unknown option: $1. Use -h for help."; exit 1 ;;
  esac
done

# --list 모드
if [ "$LIST_ONLY" = true ]; then
  weekday=$(get_weekday_kr "$TARGET_DATE")
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  📋 Antigravity 세션 목록 — ${TARGET_DATE} (${weekday}) ${FROM_HOUR}~"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""

  output=$("$SCRIPT_PATH" --collect "$TARGET_DATE" "$FROM_HOUR")
  if [ -z "$output" ]; then
    echo "  (세션이 없습니다)"
  else
    total=$(echo "$output" | wc -l | tr -d ' ')
    displayed=$(echo "$output" | tail -10)
    n=$(( total > 10 ? total - 10 : 0 ))
    while IFS=$'\t' read -r display uuid; do
      n=$((n + 1))
      printf "\033[1;36m%2d.\033[0m %s\n" "$n" "$display"
    done <<< "$displayed"
    echo ""
    if [ "$total" -gt 10 ]; then
      echo "  최근 10개 표시 (전체 ${total}개)"
    else
      echo "  총 ${total}개 세션"
    fi
  fi
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  exit 0
fi

# ═══════════════════════════════════════════════════════════════
# fzf 인터랙티브 모드
# ═══════════════════════════════════════════════════════════════

offset_file=$(mktemp)
echo "0" > "$offset_file"
trap "rm -f $offset_file" EXIT

weekday=$(get_weekday_kr "$TARGET_DATE")
init_header="📋 ${TARGET_DATE} (${weekday}, 오늘) ${FROM_HOUR}~ — ←/→ 날짜 전환, Tab 미리보기, Enter 세션 복구(agy resume), Esc 취소"

nav_left="${SCRIPT_PATH} --nav ${offset_file} prev ${FROM_HOUR}"
nav_right="${SCRIPT_PATH} --nav ${offset_file} next ${FROM_HOUR}"
hdr_cmd="${SCRIPT_PATH} --header ${offset_file} ${FROM_HOUR}"
detail_cmd="${SCRIPT_PATH} --detail {} ${offset_file} ${FROM_HOUR}"

selected=$("$SCRIPT_PATH" --collect "$TARGET_DATE" "$FROM_HOUR" \
  | tail -10 \
  | cut -f1 \
  | fzf --ansi \
        --header="$init_header" \
        --header-first \
        --reverse \
        --no-multi \
        --height=40 \
        --border=rounded \
        --prompt="세션 선택 > " \
        --preview="$detail_cmd" \
        --preview-window="right:50%:wrap:hidden" \
        --bind "left:reload($nav_left)+transform-header($hdr_cmd)" \
        --bind "right:reload($nav_right)+transform-header($hdr_cmd)" \
        --bind "tab:toggle-preview" \
  2>/tmp/fzf-agy-sessions-err || true)

if [ -s /tmp/fzf-agy-sessions-err ]; then
  echo "⚠️  fzf 오류: $(cat /tmp/fzf-agy-sessions-err)"
fi

if [ -z "$selected" ]; then
  exit 0
fi

# 선택 항목에서 UUID 추출
current_offset=$(cat "$offset_file")
current_date=$(get_date_with_offset "$current_offset")

uuid=$("$SCRIPT_PATH" --collect "$current_date" "$FROM_HOUR" \
  | tail -10 \
  | grep -F "$selected" \
  | head -1 \
  | cut -f2)

if [ -z "$uuid" ]; then
  echo "⚠️  세션 UUID를 찾지 못했습니다."
  exit 1
fi

echo ""
echo "🔄 Antigravity 세션 복구 진행 중..."
echo "▶  agy --conversation ${uuid} --dangerously-skip-permissions"
echo ""

# agy --conversation으로 세션 복구 실행 (자동 승인 옵션 포함)
exec "$AGY_BIN" --conversation "$uuid" --dangerously-skip-permissions

