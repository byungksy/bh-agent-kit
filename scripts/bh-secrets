#!/usr/bin/env bash
# bh-secrets — 인증 토큰 관리 CLI
#
# Usage:
#   bh-secrets list              # 저장된 키 목록 (값 마스킹)
#   bh-secrets get <key>         # 특정 값 출력
#   bh-secrets set <key> <value> # mcp.json에 값 저장/갱신
#   bh-secrets verify            # 각 서비스 토큰 유효성 검증

set -euo pipefail

MCP_CONFIG="${MCP_CONFIG:-$HOME/.cursor/mcp.json}"
SECRETS_SH="${AGENTS_HOME:-$HOME/.agents}/scripts/bh-secrets.sh"

BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
RESET='\033[0m'

_usage() {
  cat <<EOF
${BOLD}bh-secrets${RESET} — 인증 토큰 관리 (SSOT: mcp.json)

  ${CYAN}bh-secrets list${RESET}              저장된 키 목록 (값 마스킹)
  ${CYAN}bh-secrets get${RESET} <KEY>          특정 값 출력
  ${CYAN}bh-secrets set${RESET} <KEY> <VALUE>  mcp.json에 값 저장/갱신
  ${CYAN}bh-secrets verify${RESET}             서비스별 토큰 유효성 검증
EOF
}

# ── list ──────────────────────────────────────────────────────
_list() {
  echo ""
  echo -e "${BOLD}  저장된 인증 토큰 목록${RESET}  ${DIM}(SSOT: $MCP_CONFIG)${RESET}"
  echo ""

  python3 - "$MCP_CONFIG" <<'PYEOF'
import json, sys

path = sys.argv[1]
d = json.load(open(path))
servers = d.get("mcpServers", {})

rows = []

ENV_KEYS = [
    ("11st-bitbucket-mcp",    "BITBUCKET_BEARER_TOKEN",    "Bitbucket"),
    ("11st-bitbucket-mcp",    "BITBUCKET_EMAIL",            "Bitbucket"),
    ("slack",                 "SLACK_BOT_TOKEN",            "Slack"),
    ("sentry-selfhosted-mcp", "SENTRY_AUTH_TOKEN",          "Sentry"),
    ("groot",                 "WHATAP_API_TOKEN",           "Whatap"),
    ("browserstack",          "BROWSERSTACK_ACCESS_KEY",    "Browserstack"),
]
seen = set()
for srv_name, key, label in ENV_KEYS:
    if key in seen:
        continue
    val = servers.get(srv_name, {}).get("env", {}).get(key, "")
    rows.append((label, key, val))
    seen.add(key)

ARGS_KEYS = [
    ("mcp-atlassian", "--jira-personal-token",       "JIRA_PERSONAL_TOKEN",       "Jira"),
    ("mcp-atlassian", "--confluence-personal-token", "CONFLUENCE_PERSONAL_TOKEN", "Confluence"),
]
for srv_name, flag, export_name, label in ARGS_KEYS:
    args = servers.get(srv_name, {}).get("args", [])
    val = ""
    for i, a in enumerate(args):
        if a == flag and i + 1 < len(args):
            val = args[i + 1]
            break
    rows.append((label, export_name, val))

for label, key, val in rows:
    if val:
        masked = val[:6] + "..." + val[-4:] if len(val) > 10 else "****"
        status = "✓"
    else:
        masked = "(없음)"
        status = "✗"
    print(f"  {status}  {label:<14} {key:<32} {masked}")
PYEOF
  echo ""
}

# ── get ───────────────────────────────────────────────────────
_get() {
  local key="${1:-}"
  if [ -z "$key" ]; then
    echo "Usage: bh-secrets get <KEY>" >&2; exit 1
  fi

  # 로더 source 후 변수 출력
  # shellcheck disable=SC1090
  source "$SECRETS_SH" 2>/dev/null
  local val="${!key:-}"
  if [ -z "$val" ]; then
    echo -e "${RED}  '$key' 없음${RESET}" >&2; exit 1
  fi
  echo "$val"
}

# ── set ───────────────────────────────────────────────────────
_set() {
  local key="${1:-}" val="${2:-}"
  if [ -z "$key" ] || [ -z "$val" ]; then
    echo "Usage: bh-secrets set <KEY> <VALUE>" >&2; exit 1
  fi

  python3 - "$MCP_CONFIG" "$key" "$val" <<'PYEOF'
import json, sys

path, key, val = sys.argv[1], sys.argv[2], sys.argv[3]

with open(path) as f:
    d = json.load(f)

servers = d.get("mcpServers", {})
updated = []

# env 방식 키 매핑 (key → [서버명, ...])
ENV_MAP = {
    "BITBUCKET_BEARER_TOKEN": ["11st-bitbucket-mcp", "nginx-assistance"],
    "BITBUCKET_EMAIL":        ["11st-bitbucket-mcp", "nginx-assistance"],
    "SLACK_BOT_TOKEN":        ["slack"],
    "SENTRY_AUTH_TOKEN":      ["sentry-selfhosted-mcp"],
    "WHATAP_API_TOKEN":       ["groot"],
    "BROWSERSTACK_ACCESS_KEY":["browserstack"],
}

# args 방식 키 매핑 (key → [서버명, 플래그])
ARGS_MAP = {
    "JIRA_PERSONAL_TOKEN":       ("mcp-atlassian", "--jira-personal-token"),
    "CONFLUENCE_PERSONAL_TOKEN": ("mcp-atlassian", "--confluence-personal-token"),
}

if key in ENV_MAP:
    for srv_name in ENV_MAP[key]:
        srv = servers.get(srv_name, {})
        if "env" not in srv:
            srv["env"] = {}
        srv["env"][key] = val
        servers[srv_name] = srv
        updated.append(f"{srv_name}.env.{key}")
elif key in ARGS_MAP:
    srv_name, flag = ARGS_MAP[key]
    args = servers.get(srv_name, {}).get("args", [])
    for i, a in enumerate(args):
        if a == flag and i + 1 < len(args):
            args[i + 1] = val
            updated.append(f"{srv_name}.args.{flag}")
            break
    servers[srv_name]["args"] = args
else:
    print(f"ERROR: 알 수 없는 키 '{key}'. bh-secrets list 로 목록 확인", file=sys.stderr)
    sys.exit(1)

d["mcpServers"] = servers
with open(path, "w") as f:
    json.dump(d, f, indent=2, ensure_ascii=False)
    f.write("\n")

for loc in updated:
    print(f"  ✓ 업데이트: {loc}")
PYEOF

  echo -e "${GREEN}  저장 완료 → $MCP_CONFIG${RESET}"
}

# ── verify ────────────────────────────────────────────────────
_verify() {
  # shellcheck disable=SC1090
  source "$SECRETS_SH" 2>/dev/null

  echo ""
  echo -e "${BOLD}  토큰 유효성 검증${RESET}"
  echo ""

  local all_ok=true

  _check() {
    local label="$1" status="$2" detail="$3"
    if [ "$status" = "ok" ]; then
      echo -e "  ${GREEN}✓${RESET}  ${BOLD}${label}${RESET}  ${DIM}${detail}${RESET}"
    else
      echo -e "  ${RED}✗${RESET}  ${BOLD}${label}${RESET}  ${RED}${detail}${RESET}"
      all_ok=false
    fi
  }

  # mcp.json에서 URL 정보 일괄 추출
  read -r JIRA_URL BB_WORKSPACE SENTRY_URL <<< "$(python3 -c "
import json
d = json.load(open('$MCP_CONFIG'))
servers = d.get('mcpServers', {})

# Jira URL
args = servers.get('mcp-atlassian', {}).get('args', [])
jira_url = ''
for i, a in enumerate(args):
    if a == '--jira-url' and i+1 < len(args):
        jira_url = args[i+1].rstrip('/')
        break

# Bitbucket workspace (11st-bitbucket-mcp env에서)
bb_env = servers.get('11st-bitbucket-mcp', {}).get('env', {})
workspace = bb_env.get('DEFAULT_WORKSPACE', '11st')

# Sentry URL
sentry_env = servers.get('sentry-selfhosted-mcp', {}).get('env', {})
sentry_url = sentry_env.get('SENTRY_URL', '').rstrip('/')

print(jira_url, workspace, sentry_url)
" 2>/dev/null)"

  # Jira — Bearer 방식 (사내 Jira는 이메일 없이 토큰만 사용)
  if [ -n "${JIRA_PERSONAL_TOKEN:-}" ] && [ -n "${JIRA_URL:-}" ]; then
    result=$(curl -sf -k \
      -H "Authorization: Bearer ${JIRA_PERSONAL_TOKEN}" \
      "${JIRA_URL}/rest/api/2/myself" 2>/dev/null | \
      python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('displayName','?'))" 2>/dev/null || echo "")
    [ -n "$result" ] && _check "Jira" "ok" "$result" || _check "Jira" "fail" "401 또는 연결 실패"
  elif [ -z "${JIRA_PERSONAL_TOKEN:-}" ]; then
    _check "Jira" "fail" "토큰 없음"
  else
    _check "Jira" "fail" "jira-url 설정 없음"
  fi

  # Bitbucket — Basic Auth (email:token) 방식
  BB_EMAIL=$(python3 -c "
import json
print(json.load(open('$MCP_CONFIG')).get('mcpServers',{}).get('11st-bitbucket-mcp',{}).get('env',{}).get('BITBUCKET_EMAIL',''))
" 2>/dev/null || echo "")
  if [ -n "${BITBUCKET_BEARER_TOKEN:-}" ] && [ -n "$BB_EMAIL" ]; then
    result=$(curl -sf \
      -u "${BB_EMAIL}:${BITBUCKET_BEARER_TOKEN}" \
      "https://api.bitbucket.org/2.0/repositories/${BB_WORKSPACE:-11st}/fe-scripts?fields=full_name" 2>/dev/null | \
      python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('full_name','?'))" 2>/dev/null || echo "")
    [ -n "$result" ] && _check "Bitbucket" "ok" "$result" || _check "Bitbucket" "fail" "401 또는 연결 실패"
  else
    _check "Bitbucket" "fail" "토큰 또는 이메일 없음"
  fi

  # Sentry
  if [ -n "${SENTRY_AUTH_TOKEN:-}" ] && [ -n "${SENTRY_URL:-}" ]; then
    result=$(curl -sf \
      -H "Authorization: Bearer ${SENTRY_AUTH_TOKEN}" \
      "${SENTRY_URL}/api/0/" 2>/dev/null | \
      python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('user',{}).get('name','?') if isinstance(d.get('user'),dict) else 'ok')" 2>/dev/null || echo "")
    [ -n "$result" ] && _check "Sentry" "ok" "$result" || _check "Sentry" "fail" "401 또는 연결 실패"
  elif [ -z "${SENTRY_AUTH_TOKEN:-}" ]; then
    _check "Sentry" "fail" "토큰 없음"
  else
    _check "Sentry" "fail" "SENTRY_URL 설정 없음"
  fi

  # Slack
  if [ -n "${SLACK_BOT_TOKEN:-}" ]; then
    result=$(curl -sf \
      -H "Authorization: Bearer ${SLACK_BOT_TOKEN}" \
      "https://slack.com/api/auth.test" 2>/dev/null | \
      python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('user','?') if d.get('ok') else 'FAIL:'+d.get('error','?'))" 2>/dev/null || echo "")
    [[ "$result" != FAIL:* ]] && [ -n "$result" ] && \
      _check "Slack" "ok" "$result" || \
      _check "Slack" "fail" "${result:-연결 실패}"
  else
    _check "Slack" "fail" "토큰 없음"
  fi

  echo ""
  if $all_ok; then
    echo -e "  ${GREEN}${BOLD}모든 토큰 유효${RESET}"
  else
    echo -e "  ${YELLOW}일부 토큰 갱신 필요 → bh-secrets set <KEY> <VALUE>${RESET}"
  fi
  echo ""
}

# ── 진입점 ────────────────────────────────────────────────────
case "${1:-}" in
  list)            _list ;;
  get)             _get "${2:-}" ;;
  set)             _set "${2:-}" "${3:-}" ;;
  verify)          _verify ;;
  --help|-h|"")    _usage ;;
  *)               echo "알 수 없는 명령: $1"; _usage; exit 1 ;;
esac
