#!/usr/bin/env bash

# ── bh-ticket-maker ───────────────────────────────────────────────────────────
# 사내 Jira(Server/DC)에 이슈 티켓을 대화형 또는 CLI 옵션으로 손쉽게 생성하는 도구.
#
# 기본 정책:
#   - 프로젝트 : COMPANY (기본값, PROJECT_B 및 기타 프로젝트 선택 가능)
#   - 이슈 유형: 결함 (기본값, COMPANY=Defect, PROJECT_B=버그, 기타 유형 선택 가능)
#   - 담당자   : 기본담당자 (기본값, 사번 EMP_ID)
#   - 이슈 설명: 여러 줄(multi-line) 입력 지원 (또는 $EDITOR 열기, -d, -f, 파이프)
#   - 시작일/종료일: 미지원 (제외)
# ──────────────────────────────────────────────────────────────────────────────

set -euo pipefail

# ── 색상 정의 ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BLUE='\033[0;34m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# ── 로깅 유틸 ──────────────────────────────────────────────────────────────────
info()    { echo -e "${CYAN}▶${RESET} $*"; }
success() { echo -e "${GREEN}✔${RESET} $*"; }
warn()    { echo -e "${YELLOW}⚠${RESET}  $*"; }
error()   { echo -e "${RED}✖${RESET}  $*" >&2; }
die()     { error "$*"; exit 1; }

# ── 기본값 정의 ────────────────────────────────────────────────────────────────
DEFAULT_PROJECT="COMPANY"
DEFAULT_ISSUE_TYPE="결함"
DEFAULT_ASSIGNEE_NAME="기본담당자"
DEFAULT_ASSIGNEE_ID="EMP_ID"

PROJECT="${DEFAULT_PROJECT}"
ISSUE_TYPE="${DEFAULT_ISSUE_TYPE}"
ASSIGNEE="${DEFAULT_ASSIGNEE_ID}"
ASSIGNEE_LABEL="${DEFAULT_ASSIGNEE_NAME} (${DEFAULT_ASSIGNEE_ID})"
SUMMARY=""
DESCRIPTION=""
NO_ASSIGNEE=0
CONFIRM=1
OPEN_BROWSER=0
DRY_RUN=0
CLI_PROJECT_SET=0
CLI_TYPE_SET=0
CLI_ASSIGNEE_SET=0

# ── 도움말 ────────────────────────────────────────────────────────────────────
usage() {
  echo -e "${BOLD}사용법:${RESET}"
  echo -e "  bh-ticket-maker [옵션]"
  echo -e ""
  echo -e "${BOLD}옵션:${RESET}"
  echo -e "  -s, --summary <TEXT>        이슈 제목 (요약)"
  echo -e "  -d, --desc <TEXT>           이슈 설명 (여러 줄 지원)"
  echo -e "  -f, --file <PATH>           설명으로 사용할 파일 경로"
  echo -e "  -p, --project <KEY>         Jira 프로젝트 키 (기본값: ${DEFAULT_PROJECT})"
  echo -e "  -t, --type <NAME>           이슈 유형 (기본값: ${DEFAULT_ISSUE_TYPE})"
  echo -e "  -a, --assignee <USER/ID>    담당자 이름 또는 사번 (기본값: ${DEFAULT_ASSIGNEE_NAME})"
  echo -e "      --no-assignee           담당자 미지정(Unassigned)"
  echo -e "  -y, --yes                   생성 전 확인 프롬프트 건너뛰기"
  echo -e "  -o, --open                  생성 완료 후 기본 브라우저에서 티켓 열기"
  echo -e "      --dry-run               실제 생성 없이 요청 페이로드만 확인"
  echo -e "  -h, --help                  도움말 출력"
  echo -e ""
  echo -e "${BOLD}예시:${RESET}"
  echo -e "  # 1. 대화형 모드 (기본값 엔터로 빠르게 생성)"
  echo -e "  bh-ticket-maker"
  echo -e ""
  echo -e "  # 2. 제목과 설명 지정 실행"
  echo -e "  bh-ticket-maker -s \"쿠폰 할인 계산 오류\" -d \"상세 재현 경로:\n1. 장바구니 담기\n2. 쿠폰 선택\""
  echo -e ""
  echo -e "  # 3. PROJECT_B 프로젝트에 작업 티켓 생성"
  echo -e "  bh-ticket-maker -p PROJECT_B -t \"작업\" -s \"AI Hub 프론트엔드 최적화\""
  echo -e ""
  echo -e "  # 4. 파일 내용으로 설명 전달"
  echo -e "  bh-ticket-maker -s \"결제 오류 수정\" -f ./issue_details.md -y"
  exit 0
}

# ── 인자 파싱 ──────────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--summary)
      SUMMARY="$2"; shift 2 ;;
    -d|--desc|--description)
      DESCRIPTION="$2"; shift 2 ;;
    -f|--file)
      [[ -f "$2" ]] || die "지정한 파일을 찾을 수 없습니다: $2"
      DESCRIPTION=$(cat "$2"); shift 2 ;;
    -p|--project)
      PROJECT=$(echo "$2" | tr '[:lower:]' '[:upper:]')
      CLI_PROJECT_SET=1
      shift 2 ;;
    -t|--type)
      ISSUE_TYPE="$2"
      CLI_TYPE_SET=1
      shift 2 ;;
    -a|--assignee)
      ASSIGNEE="$2"
      ASSIGNEE_LABEL="$2"
      CLI_ASSIGNEE_SET=1
      shift 2 ;;
    --no-assignee)
      NO_ASSIGNEE=1
      ASSIGNEE=""
      ASSIGNEE_LABEL="미지정 (Unassigned)"
      CLI_ASSIGNEE_SET=1
      shift ;;
    -y|--yes)
      CONFIRM=0; shift ;;
    -o|--open)
      OPEN_BROWSER=1; shift ;;
    --dry-run)
      DRY_RUN=1; shift ;;
    -h|--help)
      usage ;;
    *)
      error "알 수 없는 옵션: $1"
      usage ;;
  esac
done

# ── 파이프 stdin 입력 처리 ────────────────────────────────────────────────────
if [[ -z "$DESCRIPTION" && ! -t 0 ]]; then
  if python3 -c "import sys, select; sys.exit(0 if select.select([sys.stdin], [], [], 0.0)[0] else 1)" 2>/dev/null; then
    DESCRIPTION=$(cat)
  fi
fi

# ── Python 헬퍼 함수들 (Bash 3.2 호환) ────────────────────────────────────────
_py_load_creds() {
  python3 - << 'PYEOF'
import os, json, re, subprocess

base_url = os.environ.get('JIRA_BASE_URL') or os.environ.get('JIRA_URL')
token = os.environ.get('JIRA_PERSONAL_TOKEN') or os.environ.get('JIRA_TOKEN')

# 1. bh-secrets CLI 확인
if not token:
    try:
        out = subprocess.check_output(['bh-secrets', 'get', 'JIRA_PERSONAL_TOKEN'], stderr=subprocess.DEVNULL)
        t = out.decode().strip()
        if t: token = t
    except Exception:
        pass

# 2. ~/.cursor/mcp.json 및 ~/.agents/mcp.json 확인
if not token or not base_url:
    for mcp_path in [os.path.expanduser('~/.cursor/mcp.json'), os.path.expanduser('~/.agents/mcp.json')]:
        if not os.path.isfile(mcp_path):
            continue
        try:
            with open(mcp_path) as f:
                d = json.load(f)
            srv = d.get('mcpServers', {}).get('mcp-atlassian', {})
            args = srv.get('args', [])
            for i, arg in enumerate(args):
                if arg == '--jira-url' and i + 1 < len(args) and not base_url:
                    base_url = args[i + 1]
                if arg == '--jira-personal-token' and i + 1 < len(args) and not token:
                    token = args[i + 1]
        except Exception:
            pass

# 3. application.yml fallback
if not token or not base_url:
    app_yml = '/Users/aEMP_ID/h1-ai-hub-overview/apps/h1-ai-server/src/main/resources/application.yml'
    if os.path.isfile(app_yml):
        try:
            with open(app_yml) as f:
                content = f.read()
            if not base_url:
                m = re.search(r'base-url:\s*([^\s]+)', content)
                if m: base_url = m.group(1)
            if not token:
                m = re.search(r'jira:\s*\n.*?token:\s*["\']?([^"\'\s\n]+)', content, re.DOTALL)
                if m: token = m.group(1)
        except Exception:
            pass

base_url = (base_url or 'https://jira.company.com').rstrip('/')
print(base_url)
print(token or '')
PYEOF
}

_py_resolve_issue_type() {
  local proj="$1"
  local raw="$2"
  python3 - "$proj" "$raw" << 'PYEOF'
import sys

proj = sys.argv[1]
raw = sys.argv[2].strip()

# '결함 (Defect) [기본값]' 등에서 앞단/괄호 추출
if '결함' in raw or 'Defect' in raw or '버그' in raw or 'Bug' in raw:
    if proj == 'COMPANY':
        print('Defect')
        sys.exit(0)
    elif proj == 'PROJECT_B':
        print('버그')
        sys.exit(0)
    else:
        print('Defect')
        sys.exit(0)

# 한국어 유형명 유지
for prefix in ['작업', '새 기능', '스토리', '에픽', '하위 작업', 'UI개발', 'Biz개발', 'App개발', '기획', 'COMPANY개발요청']:
    if raw.startswith(prefix):
        print(prefix)
        sys.exit(0)

# 괄호나 부가설명 제거 후 원본 추출
clean = raw.split('[')[0].strip()
if ' (' in clean:
    clean = clean.split(' (')[0].strip()
print(clean or raw)
PYEOF
}

_py_generate_payload() {
  local proj="$1"
  local itype="$2"
  local summary="$3"
  local desc="$4"
  local assignee="$5"
  python3 - "$proj" "$itype" "$summary" "$desc" "$assignee" << 'PYEOF'
import json, sys

project = sys.argv[1]
issuetype = sys.argv[2]
summary = sys.argv[3]
description = sys.argv[4]
assignee = sys.argv[5]

fields = {
    'project': {'key': project},
    'issuetype': {'name': issuetype},
    'summary': summary,
}

if description:
    fields['description'] = description

if assignee:
    fields['assignee'] = {'name': assignee}

print(json.dumps({'fields': fields}, ensure_ascii=False))
PYEOF
}

_py_parse_key() {
  local body="$1"
  python3 - "$body" << 'PYEOF'
import sys, json
try:
    d = json.loads(sys.argv[1])
    print(d.get('key', ''))
except Exception:
    print('')
PYEOF
}

_py_parse_error() {
  local body="$1"
  python3 - "$body" << 'PYEOF'
import sys, json
try:
    d = json.loads(sys.argv[1])
    err_msgs = d.get('errorMessages', [])
    errors = d.get('errors', {})
    for m in err_msgs:
        print(f"  - {m}")
    for k, v in errors.items():
        print(f"  - [{k}]: {v}")
except Exception:
    print(sys.argv[1])
PYEOF
}

# ── Jira 인증 및 Base URL 로드 ────────────────────────────────────────────────
_load_jira_credentials() {
  local jira_info
  jira_info=$(_py_load_creds)

  JIRA_BASE_URL=$(echo "$jira_info" | sed -n '1p')
  JIRA_TOKEN=$(echo "$jira_info" | sed -n '2p')

  if [[ -z "$JIRA_TOKEN" ]]; then
    die "Jira 인증 토큰(PAT)을 찾을 수 없습니다.
  - 방법 1: bh-secrets set JIRA_PERSONAL_TOKEN <토큰>
  - 방법 2: export JIRA_PERSONAL_TOKEN=<토큰>
  - 방법 3: ~/.cursor/mcp.json 내 mcp-atlassian 설정 확인"
  fi
}

_load_jira_credentials

# ── 대화형 항목 선택 헬퍼 (fzf 우선, tty fallback) ────────────────────────────
_select_item() {
  local prompt="$1"
  shift
  local items=("$@")

  if command -v fzf &>/dev/null && [[ -t 0 ]]; then
    local result
    result=$(printf '%s\n' "${items[@]}" \
      | fzf --prompt="  ${prompt} > " \
            --height=~40% \
            --layout=reverse \
            --border=rounded \
            --border-label=" Jira Ticket Maker " \
            --border-label-pos=top \
            --info=hidden \
            --no-sort \
            --color='border:#5BCEFA,label:#5BCEFA,prompt:#FFFFFF,pointer:#F5A623,hl:#F5A623,hl+:#F5A623' \
            2>/dev/null) || { warn "선택이 취소되었습니다."; exit 0; }
    echo "$result"
  else
    echo -e "${CYAN}▶${RESET} ${prompt}:" >&2
    local idx=1
    for item in "${items[@]}"; do
      echo "  $idx) $item" >&2
      ((idx++))
    done
    local choice
    read -r -p "  선택 번호 (기본 1): " choice
    choice="${choice:-1}"
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#items[@]} )); then
      echo "${items[$((choice-1))]}"
    else
      echo "${items[0]}"
    fi
  fi
}

# ── 프로젝트 선택 ────────────────────────────────────────────────────────────
_choose_project() {
  # CLI 옵션으로 지정되지 않았고 대화형 tty 환경인 경우
  if [[ -t 0 && $CLI_PROJECT_SET -eq 0 && $CONFIRM -eq 1 ]]; then
    local options=(
      "COMPANY    — 회원/주문/클레임/정산/셀러 MSA전환 [기본값]"
      "PROJECT_B  — 개발그룹 AI 환경 구성 프로젝트"
      "MPINNER — 내부 플랫폼"
      "직접 프로젝트 키 입력..."
    )
    local selected
    selected=$(_select_item "Jira 프로젝트를 선택하세요" "${options[@]}")

    case "$selected" in
      COMPANY*)
        PROJECT="COMPANY" ;;
      PROJECT_B*)
        PROJECT="PROJECT_B" ;;
      MPINNER*)
        PROJECT="MPINNER" ;;
      "직접 프로젝트 키 입력..."*)
        echo -ne "${CYAN}▶${RESET} 프로젝트 키를 입력하세요 (예: PROJECT_B, COMPANY, PDP): "
        read -r input_key
        PROJECT=$(echo "${input_key:-COMPANY}" | tr '[:lower:]' '[:upper:]' | tr -d ' ')
        ;;
      *)
        PROJECT="COMPANY" ;;
    esac
  fi
}

# ── 이슈 유형 결정 및 매핑 ──────────────────────────────────────────────────
_resolve_issue_type() {
  local chosen="$ISSUE_TYPE"

  # 대화형 모드이고 CLI 옵션으로 지정되지 않은 경우
  if [[ -t 0 && $CLI_TYPE_SET -eq 0 && $CONFIRM -eq 1 ]]; then
    local type_options=()
    if [[ "$PROJECT" == "COMPANY" ]]; then
      type_options=(
        "결함 (Defect) [기본값]"
        "작업 (Task)"
        "새 기능 (New Feature)"
        "COMPANY개발요청"
        "UI개발"
        "Biz개발"
        "App개발"
        "기획"
        "에픽 (Epic)"
        "Jira 서버에서 전체 목록 불러오기..."
      )
    elif [[ "$PROJECT" == "PROJECT_B" ]]; then
      type_options=(
        "결함 (버그 / Bug) [기본값]"
        "작업 (Task)"
        "스토리 (Story)"
        "에픽 (Epic)"
        "Jira 서버에서 전체 목록 불러오기..."
      )
    else
      type_options=(
        "결함 [기본값]"
        "작업 (Task)"
        "Jira 서버에서 전체 목록 불러오기..."
      )
    fi

    local sel
    sel=$(_select_item "이슈 유형을 선택하세요 (${PROJECT})" "${type_options[@]}")

    if [[ "$sel" == *"Jira 서버에서 전체 목록 불러오기"* ]]; then
      info "Jira 서버에서 ${PROJECT} 이슈 유형 목록 조회 중..."
      local fetched_types
      fetched_types=$(curl -s -k -H "Authorization: Bearer ${JIRA_TOKEN}" \
        "${JIRA_BASE_URL}/rest/api/2/issue/createmeta/${PROJECT}/issuetypes" \
        | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    for v in d.get("values", []):
        print(v["name"])
except Exception:
    pass
' 2>/dev/null || true)

      if [[ -n "$fetched_types" ]]; then
        local server_options=()
        while IFS= read -r line; do
          [[ -n "$line" ]] && server_options+=("$line")
        done <<< "$fetched_types"
        sel=$(_select_item "조회된 이슈 유형 선택" "${server_options[@]}")
        chosen="$sel"
      else
        warn "이슈 유형 조회 실패, 기본값(결함)을 사용합니다."
        chosen="결함"
      fi
    else
      chosen="$sel"
    fi
  fi

  FINAL_ISSUE_TYPE_NAME=$(_py_resolve_issue_type "$PROJECT" "$chosen")
}

# ── 담당자 선택 ──────────────────────────────────────────────────────────────
_choose_assignee() {
  if [[ $NO_ASSIGNEE -eq 1 ]]; then
    FINAL_ASSIGNEE=""
    ASSIGNEE_LABEL="미지정 (Unassigned)"
    return
  fi

  # 이미 CLI 옵션으로 지정된 경우
  if [[ $CLI_ASSIGNEE_SET -eq 1 ]]; then
    FINAL_ASSIGNEE="$ASSIGNEE"
    return
  fi

  # 대화형 선택
  if [[ -t 0 && $CONFIRM -eq 1 ]]; then
    local assignee_options=(
      "기본담당자 (EMP_ID) [기본값]"
      "다른 담당자 검색..."
      "담당자 미지정 (Unassigned)"
    )
    local sel
    sel=$(_select_item "업무 담당자를 선택하세요" "${assignee_options[@]}")

    case "$sel" in
      "기본담당자"*)
        FINAL_ASSIGNEE="EMP_ID"
        ASSIGNEE_LABEL="기본담당자 (EMP_ID)"
        ;;
      "담당자 미지정"*)
        FINAL_ASSIGNEE=""
        ASSIGNEE_LABEL="미지정 (Unassigned)"
        ;;
      "다른 담당자 검색..."*)
        echo -ne "${CYAN}▶${RESET} 검색할 사용자 이름 또는 사번: "
        read -r q
        if [[ -z "$q" ]]; then
          FINAL_ASSIGNEE="EMP_ID"
          ASSIGNEE_LABEL="기본담당자 (EMP_ID)"
        else
          info "Jira 사용자 검색 중..."
          local encoded_q
          encoded_q=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$q")
          local search_results
          search_results=$(curl -s -k -H "Authorization: Bearer ${JIRA_TOKEN}" \
            "${JIRA_BASE_URL}/rest/api/2/user/picker?query=${encoded_q}" \
            | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    for u in d.get("users", []):
        name = u.get("name", "")
        disp = u.get("displayName", name)
        print(f"{disp} | {name}")
except Exception:
    pass
' 2>/dev/null || true)

          if [[ -n "$search_results" ]]; then
            local u_options=()
            while IFS= read -r line; do
              [[ -n "$line" ]] && u_options+=("$line")
            done <<< "$search_results"
            local u_sel
            u_sel=$(_select_item "사용자 선택" "${u_options[@]}")
            FINAL_ASSIGNEE=$(echo "$u_sel" | awk -F '|' '{print $2}' | xargs)
            ASSIGNEE_LABEL="$u_sel"
          else
            warn "검색 결과가 없습니다. 기본값(${DEFAULT_ASSIGNEE_NAME})으로 설정합니다."
            FINAL_ASSIGNEE="EMP_ID"
            ASSIGNEE_LABEL="기본담당자 (EMP_ID)"
          fi
        fi
        ;;
      *)
        FINAL_ASSIGNEE="EMP_ID"
        ASSIGNEE_LABEL="기본담당자 (EMP_ID)"
        ;;
    esac
  else
    FINAL_ASSIGNEE="EMP_ID"
    ASSIGNEE_LABEL="기본담당자 (EMP_ID)"
  fi
}

# ── 제목 입력 ────────────────────────────────────────────────────────────────
_input_summary() {
  if [[ -z "$SUMMARY" ]]; then
    if [[ ! -t 0 ]]; then
      die "이슈 제목(-s, --summary)이 필요합니다."
    fi
    while [[ -z "$SUMMARY" ]]; do
      echo -ne "${CYAN}▶${RESET} ${BOLD}이슈 제목(Summary)을 입력하세요:${RESET} "
      read -r SUMMARY
      SUMMARY=$(echo "$SUMMARY" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
      if [[ -z "$SUMMARY" ]]; then
        warn "제목은 비워둘 수 없습니다. 다시 입력해 주세요."
      fi
    done
  fi
}

# ── 설명 입력 (여러 줄 지원) ─────────────────────────────────────────────────
_input_description() {
  if [[ -n "$DESCRIPTION" ]]; then
    return
  fi

  # 비대화형(-y, --dry-run)이거나 stdin이 tty가 아닌 경우 입력 생략
  if [[ ! -t 0 || $CONFIRM -eq 0 || $DRY_RUN -eq 1 ]]; then
    return
  fi

  echo ""
  echo -e "${CYAN}▶${RESET} ${BOLD}이슈 설명(Description) 입력${RESET} ${DIM}(여러 줄 지원)${RESET}"
  echo -e "  ${DIM}• 입력 완료 : 빈 줄에서 ${BOLD}Ctrl+D${RESET}${DIM} (또는 줄 입력 후 Ctrl+D)${RESET}"
  echo -e "  ${DIM}• 외부 에디터 열기: 첫 줄에 ${BOLD}:e${RESET}${DIM} 입력 후 Enter${RESET}"
  echo -e "  ${DIM}• 설명 생략: 내용 없이 바로 ${BOLD}Ctrl+D${RESET}"
  echo -e "  ${DIM}──────────────────────────────────────────────────${RESET}"

  local first_line=""
  if IFS= read -r first_line; then
    if [[ "$first_line" == ":e" || "$first_line" == ":edit" ]]; then
      local tmpfile
      tmpfile=$(mktemp /tmp/jira-desc-XXXXXX.md)
      "${EDITOR:-vim}" "$tmpfile"
      DESCRIPTION=$(cat "$tmpfile" 2>/dev/null || true)
      rm -f "$tmpfile"
    else
      local rest_lines
      rest_lines=$(cat || true)
      if [[ -n "$first_line" && -n "$rest_lines" ]]; then
        DESCRIPTION="${first_line}"$'\n'"${rest_lines}"
      elif [[ -n "$first_line" ]]; then
        DESCRIPTION="${first_line}"
      else
        DESCRIPTION="${rest_lines}"
      fi
    fi
  else
    DESCRIPTION=""
  fi
  echo ""
}

# ── 미리보기 및 생성 확인 ────────────────────────────────────────────────────
_preview_and_confirm() {
  echo ""
  echo -e "${BOLD}${CYAN}┌─────────────────────────────────────────────────────────────┐${RESET}"
  echo -e "${BOLD}${CYAN}│                   Jira 티켓 생성 정보 확인                  │${RESET}"
  echo -e "${BOLD}${CYAN}└─────────────────────────────────────────────────────────────┘${RESET}"
  echo -e "  ${BOLD}프로젝트${RESET}   : ${BLUE}${PROJECT}${RESET}"
  echo -e "  ${BOLD}이슈 유형${RESET}  : ${MAGENTA}${FINAL_ISSUE_TYPE_NAME}${RESET}"
  echo -e "  ${BOLD}업무 담당자${RESET}: ${GREEN}${ASSIGNEE_LABEL}${RESET}"
  echo -e "  ${BOLD}이슈 제목${RESET}  : ${SUMMARY}"
  if [[ -n "$DESCRIPTION" ]]; then
    local line_count
    line_count=$(echo "$DESCRIPTION" | wc -l | tr -d ' ')
    echo -e "  ${BOLD}이슈 설명${RESET}  : ${DIM}(총 ${line_count}줄)${RESET}"
    echo "$DESCRIPTION" | sed 's/^/    | /' | head -n 8
    if (( line_count > 8 )); then
      echo -e "    ${DIM}... (이하 생략)${RESET}"
    fi
  else
    echo -e "  ${BOLD}이슈 설명${RESET}  : ${DIM}(비어있음)${RESET}"
  fi
  echo -e "${CYAN}─────────────────────────────────────────────────────────────${RESET}"

  if [[ $DRY_RUN -eq 1 ]]; then
    info "[DRY-RUN] 실제 생성하지 않고 페이로드만 확인했습니다."
    PAYLOAD=$(_py_generate_payload "$PROJECT" "$FINAL_ISSUE_TYPE_NAME" "$SUMMARY" "$DESCRIPTION" "$FINAL_ASSIGNEE")
    echo -e "\n${BOLD}전송될 JSON 페이로드:${RESET}"
    python3 -c "import json, sys; print(json.dumps(json.loads(sys.argv[1]), indent=4, ensure_ascii=False))" "$PAYLOAD"
    exit 0
  fi

  if [[ $CONFIRM -eq 1 && -t 0 ]]; then
    echo -ne "  ${BOLD}위 내용으로 Jira 티켓을 생성하시겠습니까? [Y/n]:${RESET} "
    read -r ans
    ans="${ans:-y}"
    if [[ ! "$ans" =~ ^[Yy]$ ]]; then
      warn "생성이 취소되었습니다."
      exit 0
    fi
  fi
}

# ── Jira 티켓 생성 실행 ───────────────────────────────────────────────────────
_create_jira_ticket() {
  PAYLOAD=$(_py_generate_payload "$PROJECT" "$FINAL_ISSUE_TYPE_NAME" "$SUMMARY" "$DESCRIPTION" "$FINAL_ASSIGNEE")

  info "Jira 티켓 생성 요청 중..."

  local response http_code
  response=$(curl -s -k -w "\n__HTTP_STATUS__%{http_code}" \
    -X POST \
    -H "Authorization: Bearer ${JIRA_TOKEN}" \
    -H "Content-Type: application/json; charset=utf-8" \
    -d "$PAYLOAD" \
    "${JIRA_BASE_URL}/rest/api/2/issue")

  http_code=$(echo "$response" | grep -o '__HTTP_STATUS__[0-9]*' | grep -o '[0-9]*')
  local body="${response%__HTTP_STATUS__*}"

  if [[ "$http_code" -ge 200 && "$http_code" -lt 300 ]]; then
    local ticket_key browse_url
    ticket_key=$(_py_parse_key "$body")
    browse_url="${JIRA_BASE_URL}/browse/${ticket_key}"

    echo ""
    success "${BOLD}Jira 티켓이 성공적으로 생성되었습니다!${RESET}"
    echo -e "  ${BOLD}티켓 번호 :${RESET} ${CYAN}${BOLD}${ticket_key}${RESET}"
    echo -e "  ${BOLD}티켓 URL  :${RESET} ${BLUE}${browse_url}${RESET}"

    # macOS pbcopy 클립보드 복사
    if command -v pbcopy &>/dev/null; then
      echo -n "$browse_url" | pbcopy
      echo -e "  ${GREEN}✔${RESET} ${DIM}티켓 URL이 클립보드에 복사되었습니다.${RESET}"
    fi

    # 브라우저 열기
    if [[ $OPEN_BROWSER -eq 1 ]]; then
      open "$browse_url" 2>/dev/null || true
    elif [[ -t 0 && $CONFIRM -eq 1 ]]; then
      echo ""
      echo -ne "  브라우저에서 티켓을 바로 여시겠습니까? [y/N]: "
      read -r open_ans
      if [[ "$open_ans" =~ ^[Yy]$ ]]; then
        open "$browse_url" 2>/dev/null || true
      fi
    fi
  else
    error "Jira 티켓 생성 실패 (HTTP ${http_code})"
    _py_parse_error "$body" >&2
    exit 1
  fi
}

# ── 메인 실행 흐름 ────────────────────────────────────────────────────────────
main() {
  _choose_project
  _resolve_issue_type
  _choose_assignee
  _input_summary
  _input_description
  _preview_and_confirm
  _create_jira_ticket
}

main "$@"
