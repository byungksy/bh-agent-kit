            </button>
        </div>
    </header>

    <div class="editor-workspace" id="workspace">
        <textarea id="markdown-textarea"></textarea>
        <div class="drag-overlay" id="drag-overlay">
            <div style="text-align: center;">
                <i class="fa-solid fa-cloud-arrow-up" style="font-size: 48px; margin-bottom: 12px; display: block; text-align: center;"></i>
                Drop files here to embed
            </div>
        </div>
    </div>

    <div id="toast-container"></div>

    <script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>

    <script>
        let isDirty = false;
        let autoSaveTimeout = null;
        const initialContent = {{INITIAL_CONTENT}};

        // Initialize EasyMDE
        const easyMDE = new EasyMDE({
            element: document.getElementById('markdown-textarea'),
            initialValue: initialContent,
            spellChecker: false,
            placeholder: "Write your markdown here...",
            autosave: {
                enabled: false // We will handle our own auto-save
            },
            toolbar: [
                "bold", "italic", "heading", "|", 
                "quote", "unordered-list", "ordered-list", "|", 
                "link", "image", "table", "horizontal-rule", "|", 
                "preview", "side-by-side", "fullscreen", "|", 
                "guide"
            ],
            renderingConfig: {
                singleLineBreaks: false,
                codeSyntaxHighlighting: true
            }
        });

        // Set initial status to saved
        setSaveStatus('saved');

        // Track changes
        easyMDE.codemirror.on("change", function() {
            if (!isDirty) {
                isDirty = true;
                setSaveStatus('unsaved');
            }
            
            clearTimeout(autoSaveTimeout);
            autoSaveTimeout = setTimeout(() => {
                if (isDirty) {
                    saveContent(false);
                }
            }, 3000); // Auto-save after 3 seconds of inactivity
        });

        // Handle Cmd+S / Ctrl+S
        document.addEventListener('keydown', function(e) {
            if ((e.metaKey || e.ctrlKey) && e.key === 's') {
                e.preventDefault();
                saveContent(true);
            }
        });

        // Drag and Drop files inside workspace
        const workspace = document.getElementById('workspace');
        
        workspace.addEventListener('dragenter', function(e) {
            e.preventDefault();
            workspace.classList.add('drag-active');
        });

        workspace.addEventListener('dragover', function(e) {
            e.preventDefault();
            workspace.classList.add('drag-active');
        });

        workspace.addEventListener('dragleave', function(e) {
            e.preventDefault();
            if (e.relatedTarget === null || !workspace.contains(e.relatedTarget)) {
                workspace.classList.remove('drag-active');
            }
        });

        workspace.addEventListener('drop', function(e) {
            e.preventDefault();
            workspace.classList.remove('drag-active');
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                for (let file of files) {
                    uploadAndInsertFile(file);
                }
            }
        });

        // Handle drag/drop specifically on the CodeMirror instance (so users can drop directly in the text area)
        easyMDE.codemirror.on("drop", function(editor, event) {
            const files = event.dataTransfer.files;
            if (files.length > 0) {
                event.preventDefault();
                event.stopPropagation();
                for (let file of files) {
                    uploadAndInsertFile(file);
                }
            }
        });

        // Paste image from clipboard
        easyMDE.codemirror.on("paste", function(editor, event) {
            const items = (event.clipboardData || event.originalEvent.clipboardData).items;
            for (let item of items) {
                if (item.kind === 'file') {
                    const file = item.getAsFile();
                    event.preventDefault();
                    uploadAndInsertFile(file);
                }
            }
        });

        // File upload function
        function uploadAndInsertFile(file) {
            setSaveStatus('uploading');
            const reader = new FileReader();
            reader.onload = function() {
                const base64Data = reader.result.split(',')[1];
                fetch('/upload', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ filename: file.name, content: base64Data })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.status === 'success') {
                        const isImage = file.type.startsWith('image/') || 
                                        /\\.(jpg|jpeg|png|gif|svg|webp)$/i.test(file.name);
                        let markdownLink = '';
                        if (isImage) {
                            markdownLink = `![${file.name}](${data.url})`;
                        } else {
                            markdownLink = `[${file.name}](${data.url})`;
                        }
                        
                        // Insert link at cursor position
                        const doc = easyMDE.codemirror.getDoc();
                        const cursor = doc.getCursor();
                        doc.replaceRange(markdownLink, cursor);
                        
                        showToast(`Uploaded and inserted: ${file.name}`, 'success');
                        
                        // Force update editor dirty state and trigger save
                        isDirty = true;
                        setSaveStatus('unsaved');
                        saveContent(false);
                    } else {
                        showToast(`Upload failed: ${data.message}`, 'error');
                        setSaveStatus('saved');
                    }
                })
                .catch(err => {
                    showToast(`Upload failed: ${err.message || err}`, 'error');
                    setSaveStatus('saved');
                });
            };
            reader.readAsDataURL(file);
        }

        // Save markdown content to server
        function saveContent(explicit = false) {
            if (!isDirty && !explicit) return;
            
            clearTimeout(autoSaveTimeout);
            setSaveStatus('saving');
            
            const content = easyMDE.value();
            
            fetch('/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: content })
            })
            .then(res => res.json())
            .then(data => {
                if (data.status === 'success') {
                    isDirty = false;
                    setSaveStatus('saved');
                    if (explicit) {
                        showToast('Saved successfully', 'success');
                    }
                } else {
                    setSaveStatus('error');
                    showToast(`Save failed: ${data.message}`, 'error');
                }
            })
            .catch(err => {
                setSaveStatus('error');
                showToast(`Save failed: ${err.message || err}`, 'error');
            });
        }

        // Launch bh-view-md for this file via python server
        function viewInViewer() {
            // First save any unsaved changes
            if (isDirty) {
                saveContent(false);
            }
            
            fetch('/view')
            .then(res => res.json())
            .then(data => {
                if (data.status === 'success') {
                    showToast('Opening in bh-view-md...', 'info');
                } else {
                    showToast(`Failed to open viewer: ${data.message}`, 'error');
                }
            })
            .catch(err => {
                showToast(`Failed to open viewer: ${err}`, 'error');
            });
        }

        // Exit editor
        function exitEditor() {
            if (isDirty) {
                if (!confirm("You have unsaved changes. Are you sure you want to exit?")) {
                    return;
                }
            }
            
            // Call shutdown to kill the server
            fetch('/shutdown')
            .then(() => {
                document.body.innerHTML = `
                    <div style="display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100vh; font-family: Outfit, sans-serif; background-color: #0d1117; color: #c9d1d9;">
                        <i class="fa-solid fa-circle-check" style="font-size: 64px; color: #2ea44f; margin-bottom: 24px;"></i>
                        <h1 style="margin-bottom: 8px;">Editor Server Stopped</h1>
                        <p style="color: #8b949e;">You can now close this browser tab and return to the terminal.</p>
                    </div>
                `;
                window.close();
            })
            .catch(() => {
                // If shutdown request fails or browser blocks, still update UI
                document.body.innerHTML = `
                    <div style="display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100vh; font-family: Outfit, sans-serif; background-color: #0d1117; color: #c9d1d9;">
                        <h1 style="margin-bottom: 8px;">Editor Exited</h1>
                        <p style="color: #8b949e;">You can close this window now.</p>
                    </div>
                `;
            });
        }

        // Prevent accidental unload
        window.addEventListener('beforeunload', function(e) {
            if (isDirty) {
                e.preventDefault();
                e.returnValue = 'You have unsaved changes. Are you sure you want to leave?';
                return e.returnValue;
            }
        });

        // Set save status text and icon
        function setSaveStatus(status) {
            const container = document.getElementById('status-container');
            
            let iconHtml = '';
            let label = '';
            
            switch (status) {
                case 'saved':
                    iconHtml = '<i class="fa-solid fa-circle-check" style="color: #2ea44f;"></i>';
                    label = 'Saved';
                    break;
                case 'unsaved':
                    iconHtml = '<i class="fa-solid fa-circle-dot" style="color: #dbab09;"></i>';
                    label = 'Unsaved Changes';
                    break;
                case 'saving':
                    iconHtml = '<i class="fa-solid fa-spinner fa-spin" style="color: var(--accent-color);"></i>';
                    label = 'Saving...';
                    break;
                case 'uploading':
                    iconHtml = '<i class="fa-solid fa-cloud-arrow-up fa-spin" style="color: var(--accent-color);"></i>';
                    label = 'Uploading file...';
                    break;
                case 'error':
                    iconHtml = '<i class="fa-solid fa-circle-exclamation" style="color: #cf222e;"></i>';
                    label = 'Error Saving';
                    break;
            }
            
            container.innerHTML = iconHtml + ` <span id="status-text">${label}</span>`;
        }

        // Show Toast Messages
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            
            let icon = 'fa-info-circle';
            if (type === 'success') icon = 'fa-circle-check';
            if (type === 'error') icon = 'fa-exclamation-triangle';
            
            toast.innerHTML = `<i class="fa-solid ${icon}"></i> <span>${message}</span>`;
            container.appendChild(toast);
            
            // Animate in
            setTimeout(() => toast.classList.add('show'), 10);
            
            // Remove after 3 seconds
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Theme Toggle (Dark / Light)
        function toggleTheme() {
            const body = document.body;
            const currentTheme = body.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            body.setAttribute('data-theme', newTheme);
            
            const btnText = document.getElementById('theme-btn-text');
            btnText.textContent = newTheme === 'dark' ? 'Light Mode' : 'Dark Mode';
        }
    </script>
</body>
</html>
"""

class MarkdownEditHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        # Suppress logging HTTP requests to terminal to keep it clean
        pass

    def do_GET(self):
        parsed_path = urlparse(self.path)
        if parsed_path.path == '/':
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            
            # Read current markdown file content
            try:
                with open(MD_FILE_PATH, 'r', encoding='utf-8') as f:
                    content = f.read()
            except Exception as e:
                content = ""
            
            # Safe JSON replacement
            output = HTML_TEMPLATE.replace('{{FILE_NAME}}', json.dumps(FILE_NAME)[1:-1])
            output = output.replace('{{FILE_DIR}}', json.dumps(FILE_DIR)[1:-1])
            output = output.replace('{{INITIAL_CONTENT}}', json.dumps(content))
            
            self.wfile.write(output.encode('utf-8'))
            
        elif parsed_path.path.startswith('/assets/'):
            # Allow serving uploaded assets
            asset_rel_path = parsed_path.path[1:] # e.g. "assets/image.png"
            asset_abs_path = os.path.join(os.path.dirname(MD_FILE_PATH), asset_rel_path)
            if os.path.exists(asset_abs_path) and os.path.isfile(asset_abs_path):
                self.send_response(200)
                ext = os.path.splitext(asset_abs_path)[1].lower()
                mime = 'application/octet-stream'
                if ext in ['.png', '.jpg', '.jpeg', '.gif', '.svg', '.webp']:
                    mime = f'image/{ext[1:]}' if ext != '.jpg' else 'image/jpeg'
                elif ext == '.pdf':
                    mime = 'application/pdf'
                self.send_header('Content-Type', mime)
                self.end_headers()
                with open(asset_abs_path, 'rb') as f:
                    self.wfile.write(f.read())
            else:
                self.send_error(404, 'File not found')
        else:
            self.send_error(404, 'File not found')

    def do_POST(self):
        parsed_path = urlparse(self.path)
        content_length = int(self.headers.get('Content-Length', 0))
        post_data = self.rfile.read(content_length)
        
        if parsed_path.path == '/save':
            try:
                data = json.loads(post_data.decode('utf-8'))
                md_content = data.get('content', '')
                with open(MD_FILE_PATH, 'w', encoding='utf-8') as f:
                    f.write(md_content)
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"status": "success"}).encode('utf-8'))
            except Exception as e:
                self.send_response(500)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"status": "error", "message": str(e)}).encode('utf-8'))
                
        elif parsed_path.path == '/upload':
            try:
                data = json.loads(post_data.decode('utf-8'))
                filename = data.get('filename', 'upload')
                content_base64 = data.get('content', '')
                
                # Sanitize filename
                name, ext = os.path.splitext(os.path.basename(filename))
                name = "".join([c for c in name if c.isalnum() or c in (' ', '_', '-')]).rstrip()
                name = name.replace(' ', '_')
                if not name:
                    name = "upload"
                
                # Check target directory
                assets_dir = os.path.join(os.path.dirname(MD_FILE_PATH), 'assets')
                if not os.path.exists(assets_dir):
                    os.makedirs(assets_dir)
                
                # Unique filename to avoid overwrite
                unique_name = f"{name}_{int(time.time())}{ext}"
                target_path = os.path.join(assets_dir, unique_name)
                
                # Decode base64
                file_bytes = base64.b64decode(content_base64)
                with open(target_path, 'wb') as f:
                    f.write(file_bytes)
                
                relative_url = f"assets/{unique_name}"
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({
                    "status": "success", 
                    "url": relative_url,
                    "filename": unique_name
                }).encode('utf-8'))
            except Exception as e:
                self.send_response(500)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"status": "error", "message": str(e)}).encode('utf-8'))
        
        elif parsed_path.path == '/view':
            try:
                # Try running from absolute bin folder or PATH
                viewer_path = 'bh-view-md'
                home_bin = os.path.expanduser('~/bin/bh-view-md')
                if os.path.exists(home_bin):
                    viewer_path = home_bin
                
                subprocess.Popen([viewer_path, MD_FILE_PATH])
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"status": "success"}).encode('utf-8'))
            except Exception as e:
                self.send_response(500)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(json.dumps({"status": "error", "message": str(e)}).encode('utf-8'))
                
        elif parsed_path.path == '/shutdown':
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps({"status": "shutting_down"}).encode('utf-8'))
            # Schedule shutdown in a short delay so response can finish sending
            def kill_server():
                time.sleep(0.3)
                print("\\nShutting down editor server. Bye!")
                os._exit(0)
            threading.Thread(target=kill_server).start()

def get_free_port():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.bind(('127.0.0.1', 0))
    port = s.getsockname()[1]
    s.close()
    return port

def main():
    port = get_free_port()
    server_address = ('127.0.0.1', port)
    
    try:
        httpd = HTTPServer(server_address, MarkdownEditHandler)
    except Exception as e:
        print(f"Error starting server: {e}")
        sys.exit(1)
        
    url = f"http://127.0.0.1:{port}/"
    print(f"==================================================")
    print(f" bh-edit-md: Editing {FILE_NAME}")
    print(f" Local Server running at: {url}")
    print(f" File path: {MD_FILE_PATH}")
    print(f"==================================================")
    print(f"Opening editor in your web browser...")
    print(f"Press Ctrl+C or click 'Exit' in browser to stop.")
    
    # Open browser after a small delay to make sure server is ready
    threading.Timer(0.5, lambda: webbrowser.open(url)).start()
    
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\\nShutting down editor server. Bye!")
        sys.exit(0)

if __name__ == '__main__':
    main()
