    <header>
        <div class="header-title-container">
            <i class="fa-solid fa-file-pen"></i>
            <span class="header-title">{{FILE_NAME}}</span>
            <span class="header-path">{{FILE_DIR}}</span>
            <div class="status-pill" id="status-container">
                <i class="fa-solid fa-circle-check" style="color: #2ea44f;"></i>
                <span id="status-text">Saved</span>
            </div>
        </div>
        
        <div class="controls">
            <button class="btn" onclick="toggleTheme()" title="테마 전환">
                <i class="fa-solid fa-circle-half-stroke"></i>
                <span id="theme-btn-text">Light Mode</span>
            </button>
            <button class="btn" onclick="viewInViewer()" title="뷰어로 보기">
                <i class="fa-solid fa-eye"></i>
                <span>Open in Viewer</span>
            </button>
            <button class="btn btn-primary" onclick="saveContent(true)" title="저장 (Cmd+S)">
                <i class="fa-solid fa-floppy-disk"></i>
                <span>Save</span>
            </button>
            <button class="btn btn-danger" onclick="exitEditor()" title="편집기 종료">
                <i class="fa-solid fa-right-from-bracket"></i>
